#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
};

/ {
    behaviors {
        lp: lp {
            compatible = "zmk,behavior-hold-tap";
            label = "lp";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
        };

        esc_ij_dance: esc_ij_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ESC_IJ_DANCE";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE>, <&mo 4>;
        };

        esc_ij: esc_ij {
            compatible = "zmk,behavior-hold-tap";
            label = "ESC_IJ";
            bindings = <&mo>, <&esc_ij_dance>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        double_shift: double_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &kp LEFT_SHIFT>;
            label = "DOUBLE_SHIFT";
            wait-ms = <40>;
            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "";
            bindings = <
&trans  &kp Q         &kp W         &kp E        &lp LG(R) R  &lp LG(T) T    &kp Y            &kp U        &kp I        &kp O         &kp P            &trans
&trans  &hml LSHFT A  &hml LCTRL S  &hml LALT D  &hml LGUI F  &kp G          &kp H            &hmr RGUI J  &hmr RALT K  &hmr RCTRL L  &hmr RSHFT SEMI  &trans
&trans  &kp Z         &kp X         &lp LG(C) C  &lp LG(V) V  &kp B          &lp LG(N) N      &kp M        &kp COMMA    &kp DOT       &kp FSLH         &trans
                                    &esc_ij 2 0  &lt 1 TAB    &lt 3 SPACE    &lt 3 BACKSPACE  &lt 1 DEL    &esc_ij 2 0
            >;

            label = "Base";
        };

        sym_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL       &kp AT    &kp HASH      &kp AMPS   &kp PERCENT    &kp CARET  &kp AMPS        &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE           &trans
&trans  &kp CARET      &kp AMPS  &kp ASTERISK  &kp GRAVE  &kp TILDE      &kp EQUAL  &kp MINUS       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT            &trans
&trans  &kp BACKSLASH  &trans    &trans        &trans     &trans         &kp PLUS   &kp UNDERSCORE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOUBLE_QUOTES  &trans
                                 &trans        &trans     &trans         &trans     &trans          &trans
            >;

            label = "Symbols";
        };

        num_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &kp PLUS   &kp N7        &kp N8  &kp N9  &kp ASTRK  &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &kp MINUS  &kp NUMBER_4  &kp N5  &kp N6  &kp COLON  &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &kp EQUAL  &kp N1        &kp N2  &kp N3  &kp SLASH  &trans
                          &trans   &trans   &trans     &trans     &kp N0        &trans
            >;

            label = "Num";
        };

        sfn_layer {
            bindings = <
&trans  &trans  &kp LG(LS(NUMBER_2))  &trans  &kp LG(LS(NUMBER_4))  &trans           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC      &kp C_MUTE        &kp C_VOL_DN               &kp C_VOL_UP  &trans
&trans  &trans  &trans                &trans  &trans                &trans           &kp LEFT              &kp DOWN                  &kp UP            &kp RIGHT                  &kp C_NEXT    &trans
&trans  &trans  &trans                &trans  &trans                &kp RA(SLASH)    &kp RA(SLASH)         &kp LG(LS(LEFT_BRACKET))  &kp LC(UP_ARROW)  &kp LG(LS(RIGHT_BRACKET))  &kp C_PREV    &trans
                                      &mo 5   &kp C_PP              &kp SPACE        &kp ENTER             &trans                    &mo 5
            >;

            label = "SpaceFN";
        };

        ij_layer {
            bindings = <
&trans  &trans             &trans      &kp LC(LS(A))   &kp LS(F6)     &kp LG(LS(T))    &trans                  &kp LA(F7)        &trans                &trans                   &kp LG(LA(P))  &trans
&trans  &kp LG(LA(LS(A)))  &kp LG(F6)  &kp LA(LS(F5))  &kp LGUI       &trans           &kp LG(LA(LEFT_ARROW))  &kp LA(LS(DOWN))  &kp LA(LS(UP_ARROW))  &kp LG(LA(RIGHT_ARROW))  &trans         &trans
&trans  &trans             &trans      &trans          &kp LG(LA(V))  &trans           &kp LG(LA(N))           &kp LG(LA(M))     &kp LC(LS(J))         &trans                   &double_shift  &trans
                                       &trans          &trans         &trans           &trans                  &trans            &trans
            >;

            label = "IntelliJ";
        };

        sys_layer {
            bindings = <
&trans  &bootloader   &trans        &trans        &trans        &bt BT_CLR      &trans  &trans  &trans  &soft_off  &bootloader  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans     &trans       &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans     &trans       &trans
                                    &trans        &trans        &trans          &trans  &trans  &trans
            >;

            label = "System";
        };
    };
};
